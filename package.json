{
	"name": "gobo-translation-modifications",
	"description": "Gobo Directus interface: all translation languages in a horizontal grid",
	"icon": "extension",
	"version": "1.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/larsgobo/gobo-directus-translating-modifications-extension.git"
	},
	"bugs": {
		"url": "https://github.com/larsgobo/gobo-directus-translating-modifications-extension/issues"
	},
	"homepage": "https://github.com/larsgobo/gobo-directus-translating-modifications-extension#readme",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-interface"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "interface",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"dependencies": {
		"lodash-es": "^4.17.21"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "17.1.4",
		"@types/node": "^22.13.4",
		"typescript": "^5.8.2",
		"vue": "^3.5.13"
	}
}
